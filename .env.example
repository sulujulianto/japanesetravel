APP_NAME=JapanTravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Railway production example:
# APP_ENV=production
# Generate APP_KEY once with `php artisan key:generate --show`, then store it
# as a Railway environment secret. Do not regenerate it on every deploy.
# APP_DEBUG=false
# APP_URL=https://your-app.up.railway.app
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Railway production example:
# LOG_CHANNEL=stack
# LOG_STACK=stderr
# LOG_LEVEL=info
# Sentry production example:
# SENTRY_LARAVEL_DSN=
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_SEND_DEFAULT_PII=false

# Laravel's MariaDB driver is explicit; browser code must never connect directly.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=japantravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Production Redis session example:
# SESSION_DRIVER=redis
# SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ADMIN_COOKIE=
# Railway production example:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Production note:
# MEDIA_DISK=public requires persistent storage. On Railway, mount a Volume at
# /var/www/html/storage/app/public and keep the public/storage symlink available.
# S3 is an optional future strategy and requires installing league/flysystem-aws-s3-v3
# plus provider-specific bucket, endpoint, and public URL configuration before use.
QUEUE_CONNECTION=database
# railway/run-worker.sh currently runs the database queue connection explicitly.
# Keep QUEUE_CONNECTION=database for that worker until the script is generalized.

CACHE_STORE=database
# Production Redis cache example:
# CACHE_STORE=redis
# REDIS_CACHE_CONNECTION=cache
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache

# Local/development only: writes email content to the application log and
# does not deliver reset-password or verification emails to a real inbox.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# Production SMTP example (replace every placeholder in the deployment env):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.provider.example
# MAIL_PORT=587
# MAIL_USERNAME=your-production-smtp-username
# MAIL_PASSWORD=your-production-smtp-password
# MAIL_FROM_ADDRESS=no-reply@your-production-domain.example
# MAIL_FROM_NAME="${APP_NAME}"
# Use MAIL_SCHEME=smtps with the provider's matching port when implicit TLS is required.
# Transactional API mailers such as Mailgun, Postmark, or Resend require their
# provider-specific Laravel transport/dependency and credentials before use.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional travel inquiry number in international digits only, without "+" or spaces.
# Leave empty to show the informational disabled state on destination pages.
TRAVEL_WHATSAPP_NUMBER=

# Payment defaults below are for sandbox/testing only. Never commit real
# credentials. APP_URL must be the public HTTPS deployment URL so provider
# callbacks and the generated PayPal return/cancel URLs are reachable.
MIDTRANS_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false

PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
# Register POST ${APP_URL}/payments/webhook/paypal in the PayPal sandbox app,
# then place its sandbox webhook ID here.
PAYPAL_WEBHOOK_ID=your-paypal-sandbox-webhook-id
PAYPAL_IS_PRODUCTION=false
PAYPAL_CURRENCY=USD
# Manual IDR-per-PAYPAL_CURRENCY rate used by the current PayPal driver.
PAYPAL_EXCHANGE_RATE=15000
